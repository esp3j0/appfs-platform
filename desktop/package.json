{
  "name": "appfs-desktop-shell",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "tsc && electron .",
    "test": "npx tsx --test src/**/*.test.ts",
    "prepack-clean": "node scripts/prepack-clean.js",
    "pack": "npm run prepack-clean && node scripts/prepare-assets.js && tsc && electron-builder --dir",
    "dist": "npm run prepack-clean && node scripts/prepare-assets.js && tsc && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "electron": "^33.2.0",
    "electron-builder": "^24.13.3",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/static": "^8.0.4",
    "chokidar": "^4.0.0",
    "fastify": "^5.3.0",
    "tree-kill": "^1.2.2",
    "yaml": "^2.9.0"
  },
  "build": {
    "appId": "com.appfs.desktop",
    "asar": true,
    "win": {
      "signAndEditExecutable": false
    },
    "asarUnpack": [
      "dashboard/server/dist/**/*"
    ],
    "files": [
      "dist/**/*",
      "package.json",
      "dashboard/dist/**/*",
      "dashboard/server/dist/**/*",
      "dashboard/server/package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "agentfs.exe",
          "agentfs",
          "claw.exe",
          "claw"
        ]
      }
    ]
  }
}
